    config="GLOBAL: (KEYS=-1, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=1, VALIDATE_VERSION=1, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=20, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, TMP_PATH=/tmp)"
    sed -i "1s|.*|$config|" /usr/local/etc/scanoss/ldb/test_kb.conf
    
    ../ldb -q -u source_crc64/mined2 -n test_kb -q
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "GLOBAL configuration:")
    config="GLOBAL configuration: (KEYS=-1, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=1, VALIDATE_VERSION=1, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=20, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, TMP_PATH=/tmp)"
    assert_equals "$config" "$result"
    
    echo "bulk insert test_kb/file from source_crc64/mined/file with (TMP_PATH=/var,FILE_DEL=0,THREADS=30,KEY_SIZE=8)" | ../ldb -q
    config="file configuration: (KEYS=2, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=3, VALIDATE_VERSION=1, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=30, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, TMP_PATH=/var)"
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:")
    assert_equals "$config" "$result"

    config="GLOBAL: (COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, VALIDATE_VERSION=1, TMP_PATH=/tmp)"
    cores=$(nproc)
    threads=$((cores / 2))
    sed -i "1s|.*|$config|" /usr/local/etc/scanoss/ldb/test_kb.conf
    
    echo "bulk insert test_kb/file from source_crc64/mined/file with (TMP_PATH=/var,FILE_DEL=0,KEY_SIZE=8)" | ../ldb -q
    config="file configuration: (KEYS=2, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=3, VALIDATE_VERSION=1, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=$threads, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, TMP_PATH=/var)"
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:")
    assert_equals "$config" "$result"

    echo "bulk insert test_kb from source_crc64/mined with (TMP_PATH=/var,FILE_DEL=0,VALIDATE_VERSION=0,KEY_SIZE=8)" | ../ldb -q
    config="file configuration: (KEYS=2, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=3, VALIDATE_VERSION=0, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=$threads, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=50, TMP_PATH=/var)"
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:")
    assert_equals "$config" "$result"
}

#Regression: a non-default MAX_RAM_PERCENT set in the config file must survive
#the option merge. Two bugs dropped it: (1) opt_add() handled tmp_path as
#params_arr index IMPORT_PARAMS_NUMBER-1, which actually aliases
#collate_max_ram_percent, so setting TMP_PATH (always set in the default config)
#silently discarded MAX_RAM_PERCENT; (2) the UNDEFINED sentinel for
#collate_max_ram_percent was 50 instead of -1, so empty command-line options
#forced 50 over the file value. Both are needed for this to pass.
test_11_max_ram_percent_from_config() {
    config="GLOBAL: (KEYS=-1, KEY_SIZE=8, VALIDATE_FIELDS=1, FIELDS=1, VALIDATE_VERSION=1, SORT=1, FILE_DEL=0, OVERWRITE=0, WFP=0, MZ=0, VERBOSE=0, THREADS=20, COLLATE=0, MAX_RECORD=2048, MAX_RAM_PERCENT=5, TMP_PATH=/tmp)"
    sed -i "1s|.*|$config|" /usr/local/etc/scanoss/ldb/test_kb.conf

    echo "bulk insert test_kb/file from source_crc64/mined/file with (KEY_SIZE=8)" | ../ldb -q
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:" | grep -oE "MAX_RAM_PERCENT=[0-9]+")
    assert_equals "MAX_RAM_PERCENT=5" "$result" "config-file MAX_RAM_PERCENT overwritten by default during option merge"
}

#MAX_RAM_PERCENT is a percentage: an explicit -1 (or any out-of-range value) must
#normalize to the default (50), both in the effective value and in the logged config.
test_11b_max_ram_percent_out_of_range() {
    # -1 received on the command line must fall back to 50
    echo "bulk insert test_kb/file from source_crc64/mined/file with (KEY_SIZE=8,MAX_RAM_PERCENT=-1)" | ../ldb -q
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:" | grep -oE "MAX_RAM_PERCENT=[0-9]+")
    assert_equals "MAX_RAM_PERCENT=50" "$result" "MAX_RAM_PERCENT=-1 must fall back to default 50"

    # an out-of-range value (>100) must also fall back to 50
    echo "bulk insert test_kb/file from source_crc64/mined/file with (KEY_SIZE=8,MAX_RAM_PERCENT=150)" | ../ldb -q
    result=$(tac /var/log/scanoss/ldb/test_kb.log | grep -m 1 "file configuration:" | grep -oE "MAX_RAM_PERCENT=[0-9]+")
    assert_equals "MAX_RAM_PERCENT=50" "$result" "MAX_RAM_PERCENT>100 must fall back to default 50"
}

#ldb_fetch_recordset documents sector as optional (NULL => open from table+key).
#The CLI always passes a stack sector, so this C client covers the NULL path.
test_12_null_sector_contract() {
    gcc -o /tmp/null_sector_test null_sector_test.c -lldb -lm -lpthread -ldl -lz -lgcrypt 2>/tmp/null_sector_build.log
    assert "test -x /tmp/null_sector_test" "failed to build null_sector_test: $(cat /tmp/null_sector_build.log)"
    records=$(/tmp/null_sector_test test_kb/file 0000000000000001 | grep -oE 'records=[0-9]+' | cut -d= -f2)
    assert "[ \"${records:-0}\" -ge 1 ]" "NULL sector contract failed for CRC64 table (records=$records)"
}

#Regression: KEYS=3 file format (main key + two binary CRC64 subkeys, no ASCII
#data field). Production ossv2/file uses KEYS=3, but the rest of this suite only
#exercises the KEYS=2 file table (field3 = ASCII path). The import used to convert
#only the first subkey to binary, storing the second key as ASCII text prefixed
#with 8 zero bytes (32-byte record) instead of an 8-byte binary key (16-byte
#record). This test locks in the correct binary layout.
test_13_keys3_binary_subkeys() {
    # Start from a clean state so leftovers from a prior (possibly failed) run
    # cannot contaminate the assertion.
    rm -rf /var/lib/ldb/test_kb3 /usr/local/etc/scanoss/ldb/test_kb3.conf /var/log/scanoss/ldb/test_kb3.log
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/k3file"
    printf '89b71509aa39eb81,0013aa786d545365,29d0b7ae387ca14c\n89b71509aa39eb81,002325b3101f5061,3ba287571bd8b966\n' > "$tmpdir/k3file/89.csv"
    echo "bulk insert test_kb3/file from $tmpdir/k3file/89.csv with (KEYS=3,KEY_SIZE=8,FIELDS=3,VALIDATE_VERSION=0,OVERWRITE=1)" | ../ldb -q

    # Whole record must be the two subkeys in BINARY (16 bytes total),
    # NOT the buggy 8 zero bytes + 16 ASCII chars (32 bytes).
    result=$(echo "select from test_kb3/file key 89b71509aa39eb81 csv hex -1" | ../ldb -q | head -n1)
    assert_equals "89b71509aa39eb81,0013aa786d54536529d0b7ae387ca14c," "$result" "keys=3: subkeys not stored as binary"

    # csv hex 16 must split into main key + first subkey (hex) + second key rendered
    # from its raw 8 binary bytes (0x29 0xd0 ... which is NOT the ASCII "29d0...").
    result=$(echo "select from test_kb3/file key 89b71509aa39eb81 csv hex 24" | ../ldb -q | head -n1)
    assert_equals "89b71509aa39eb81,0013aa786d54536529d0b7ae387ca14c," "$result" "keys=3: second key not decoded to binary"

    rm -rf "$tmpdir" /var/lib/ldb/test_kb3 /usr/local/etc/scanoss/ldb/test_kb3.conf /var/log/scanoss/ldb/test_kb3.log
}

setup_suite () {
    echo 'bulk insert test_kb from source_crc64/mined with (KEY_SIZE=8)' | ../ldb
}
